rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the caller is the verified administrator via UID (Zero email exposure)
    function isAdmin() {
      return request.auth != null && 
             request.auth.uid == "vmPKKqhHjjbH4PbqVWFmSVoRkJp1";
    }

    // Helper function to validate video document structure and types
    function isValidVideoData(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 250 &&
             data.videoUrl is string && data.videoUrl.size() > 0 && data.videoUrl.size() <= 1000 &&
             data.category is string && data.category.size() <= 100 &&
             (data.aspectRatio == "16:9" || data.aspectRatio == "9:16") &&
             data.isFeatured is bool &&
             (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 150)) &&
             (!('clientOrder' in data) || data.clientOrder is number) &&
             (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 600000)) &&
             (!('duration' in data) || (data.duration is string && data.duration.size() <= 50)) &&
             (!('order' in data) || data.order is number) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 3000)) &&
             (!('isVisible' in data) || data.isVisible is bool);
    }

    // Videos collection rules
    match /videos/{videoId} {
      // 1. PUBLIC READ: Anyone can browse the video portfolio on GitHub Pages
      allow read: if true;

      // 2. ADMIN-ONLY CREATE: Only authenticated admin can create valid videos
      allow create: if isAdmin() && isValidVideoData(request.resource.data);

      // 3. ADMIN-ONLY UPDATE: Only authenticated admin can update videos with valid data
      allow update: if isAdmin() && isValidVideoData(request.resource.data);

      // 4. ADMIN-ONLY DELETE: Only authenticated admin can delete videos
      allow delete: if isAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

